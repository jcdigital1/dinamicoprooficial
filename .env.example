# ==========================================
# DINÂMICO PRO — VARIÁVEIS DE AMBIENTE
# ==========================================

# 1. Configuração do Domínio Público (Obrigatório em Produção na Vercel)
# Este é o domínio que será codificado nos QR Codes impressos.
# Exemplo: https://placas.suagrafica.com.br
VITE_PUBLIC_DOMAIN="https://suadominio.com"

# 2. Configurações do Firebase (Projeto Dedicado do Comprador)
# Obtenha estas credenciais no Firebase Console > Project Settings > General > Your apps (Web)
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef"
VITE_FIREBASE_DATABASE_ID="seu-database-id"

# 3. Chaves do Sistema AI Studio
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

