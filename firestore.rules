rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (default deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'jeannmkt2@gmail.com' ||
          request.auth.token.email == 'jeanncarllosmkt@gmail.com'
        ))
      );
    }

    function isApprovedUser() {
      return isSignedIn() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
        )
      );
    }

    // Admin collection (registry of verified administrators)
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Users collection (buyer accounts and approval statuses)
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      // On registration, ordinary user cannot self-assign admin role or approved status
      allow create: if (isOwner(userId) && request.resource.data.id == userId && request.resource.data.role == 'user' && request.resource.data.status == 'pending') || isAdmin();
      // Ordinary user can only update basic profile fields (name, phone, updatedAt); only admin can change status/role
      allow update: if (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phone', 'updatedAt'])
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // Plate Models (Templates)
    match /plateModels/{modelId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.isDefault == true || isAdmin());
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Batches (Production batches - isolated per user, full view for admin)
    match /batches/{batchId} {
      allow get: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if (isApprovedUser() && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow update: if (isApprovedUser() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if (isApprovedUser() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Plates (NFC & QR Code plates)
    // Dynamic redirection: Public visitors MUST be able to get a single plate document
    match /plates/{plateId} {
      allow get: if true;
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if (isApprovedUser() && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow update: if (
        // Approved owner can update destination/details
        (isApprovedUser() && resource.data.userId == request.auth.uid) ||
        // Public visitor can increment clicksCount only
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicksCount'])) ||
        // Admin override
        isAdmin()
      );
      allow delete: if (isApprovedUser() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Counters (atomic monotonic number generation)
    match /counters/{counterId} {
      allow get: if isSignedIn();
      allow create, update: if isApprovedUser() || isAdmin();
      allow delete: if false;
    }

    // Installation Settings
    match /settings/{settingId} {
      allow get: if true;
      allow list, create, update: if isAdmin();
      allow delete: if false;
    }
  }
}
